# ==== Core [PHASE 1: IMPLEMENTED] ====
ENV=development
LOG_LEVEL=info

# ==== Database [PHASE 2: IMPLEMENTED] ====
DATABASE_URL=postgresql+asyncpg://sathyascan:sathyascan@localhost:5432/sathyascan
REDIS_URL=redis://localhost:6379/0

# ==== WhatsApp Business Cloud API (Meta) [PHASE 1: IMPLEMENTED] ====
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Graph API version — added during Phase 1 implementation, not in the original
# architecture docs; bump when Meta deprecates the current version.
WHATSAPP_API_VERSION=v21.0

# ==== AI / LLM [PHASE 2: IMPLEMENTED] ====
ANTHROPIC_API_KEY=
# Added during Phase 2 implementation — not in the original architecture docs.
ANTHROPIC_MODEL=claude-sonnet-5
# Evidence search provider (e.g. Tavily, Bing/Google Programmable Search)
SEARCH_API_KEY=
SEARCH_API_PROVIDER=tavily

# ==== Image-generation / manipulation detection (docs/decisions.md §2)
# [PHASE 3: INTERFACE IMPLEMENTED, NO REAL PROVIDER WIRED] — confirmed scope
# decision: wiring a real third-party provider (Hive/Sightengine/Reality
# Defender/etc.) was explicitly deferred this phase (new external API,
# no credentials available). NullImageForensicsProvider always reports
# "unavailable" — never a fabricated probability. See
# app/agent/tools/image_analysis.py. ====
IMAGE_ANALYSIS_PROVIDER=
IMAGE_ANALYSIS_API_KEY=
# Old placeholder name from the original architecture docs — superseded by
# IMAGE_ANALYSIS_PROVIDER/_API_KEY above, kept here only so nothing that
# referenced this name breaks; not read by application code.
MEDIA_FORENSICS_PROVIDER=hive
MEDIA_FORENSICS_API_KEY=

# ==== OCR (docs/decisions.md §11) [PHASE 3: INTERFACE IMPLEMENTED, NO REAL
# ENGINE WIRED] — decisions.md §11 requires benchmarking BEFORE engine
# lock-in; no OCR credentials and no curated Malayalam/Tamil/Hindi/English
# benchmark set exist in this build environment, so no engine has been
# selected. This is a documented, flagged gap (see
# docs/risks-and-open-questions.md), not a silent pass. NullOCRProvider
# always reports "provider_unavailable" — never a fabricated "no text
# found". See app/agent/tools/ocr.py. ====
#
# A REAL option now exists: OCR_PROVIDER=claude_vision reads text from
# forwarded images using the SAME Anthropic model this deployment already
# needs — it reuses ANTHROPIC_API_KEY and requires NO extra dependency, no
# second credential, and no separate OCR service. Required if you want
# forwarded IMAGES/screenshots to be fact-checked; leave empty and images
# will honestly reply "couldn't find readable text in this image".
# Selecting it does NOT satisfy decisions.md §11's accuracy-benchmark rule —
# it only makes a real engine available to opt into.
OCR_PROVIDER=
# Unused by claude_vision (it uses ANTHROPIC_API_KEY). Reserved for a future
# dedicated OCR vendor that needs its own key.
OCR_API_KEY=

# ==== URL Analyzer / URL Safety Module (docs/decisions.md §3/§15, Phase 4)
# [PHASE 4: IMPLEMENTED FOR REAL] — unlike OCR/image-analysis/safety-gate,
# the fetcher, robots.txt check, HTML extraction, and domain-age (WHOIS)
# checker below all need NO credentials and are genuinely wired, not
# stubbed. See app/web/{fetcher,robots,html_extraction,domain_age}.py and
# app/agent/tools/{url_analyzer,url_safety}.py. ====
URL_FETCH_TIMEOUT_SECONDS=10.0
MAX_URL_FETCH_SIZE_BYTES=5242880
MAX_URL_REDIRECTS=5
URL_FETCH_USER_AGENT=SathyaScanBot/1.0 (+https://sathyascan.example/bot)
MAX_URL_CONTENT_LENGTH_CHARS=20000
URL_ROBOTS_TXT_CHECK_ENABLED=true
WHOIS_LOOKUP_TIMEOUT_SECONDS=5.0

# ==== Threat intelligence / Safe Browsing-style API (Phase 4) [INTERFACE
# IMPLEMENTED, NO REAL PROVIDER WIRED] — confirmed scope decision: explicitly
# marked OPTIONAL in docs/phased-plan.md's Phase 4 row, and this environment
# has no credentials for Google Safe Browsing / PhishTank / VirusTotal /
# etc. NullThreatIntelProvider always reports no matches — never fabricates
# a match, and its absence is never treated as a verified "safe" signal
# either. See app/agent/tools/url_safety.py. ====
THREAT_INTEL_PROVIDER=
THREAT_INTEL_API_KEY=

# ==== Security ====
# HMAC signing secret for dashboard JWTs (app/core/jwt_auth.py). [PHASE 6:
# IMPLEMENTED] — was an unused placeholder through Phases 1-5; generate a
# long random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Empty/unset fails loud (token issuance refuses to sign with an empty secret).
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
# Server-side pepper for phone_number_hash — NOT the same as JWT_SECRET, rotate
# independently. [PHASE 1: IMPLEMENTED]
PHONE_HASH_PEPPER=
# AES-256-GCM key (32 bytes, base64) for phone_number_encrypted (users table).
# [PHASE 2: IMPLEMENTED — interim local-key substitute for the eventual
# KMS-managed key referenced by KMS_KEY_ID below; see app/core/encryption.py
# for the documented scope note. Generate one with:
#   python -c "from app.core.encryption import generate_encryption_key as g; print(g())"
PHONE_ENCRYPTION_KEY=
# KMS key reference for phone_number_encrypted envelope encryption [NOT YET
# USED — real cloud KMS integration is a future replacement for PHONE_ENCRYPTION_KEY]
KMS_KEY_ID=

# ==== Blob storage [NOT YET USED — Phase 3 deliberately implements NO blob
# storage at all: media is downloaded to memory, validated, safety-checked,
# and OCR'd within one background task, then discarded. "Secure cleanup"
# holds by construction. Revisit only if a future phase needs to persist
# media (e.g. for appeals review).] ====
BLOB_STORAGE_PROVIDER=local
BLOB_STORAGE_BUCKET=

# ==== Rate limiting & abuse protection (docs/decisions.md §12) ====
# RATE_LIMIT_PER_USER_PER_MINUTE, IDEMPOTENCY_TTL_SECONDS [PHASE 1: IMPLEMENTED]
# GLOBAL_LLM_SEARCH_CONCURRENCY_LIMIT, DUPLICATE_CONTENT_REUSE_* [PHASE 2: IMPLEMENTED]
# MAX_UPLOAD_SIZE_BYTES_IMAGE, MAX_IMAGE_PIXELS, MEDIA_DOWNLOAD_TIMEOUT_SECONDS [PHASE 3: IMPLEMENTED]
# MAX_UPLOAD_SIZE_BYTES_AUDIO/VIDEO, MAX_PROCESSING_DURATION_SECONDS [PHASE 5:
# IMPLEMENTED — see app/core/pipeline_timeout.py; the wall-clock timeout is
# now actually enforced, applied uniformly to every pipeline, not just
# audio/video]. GLOBAL_HEAVY_QUEUE_CONCURRENCY_LIMIT remains [NOT YET USED —
# no separate Celery "heavy" queue exists; audio/video share
# GLOBAL_LLM_SEARCH_CONCURRENCY_LIMIT like every other pipeline, see
# docs/risks-and-open-questions.md]
RATE_LIMIT_PER_USER_PER_MINUTE=10
IDEMPOTENCY_TTL_SECONDS=86400
GLOBAL_LLM_SEARCH_CONCURRENCY_LIMIT=20
GLOBAL_HEAVY_QUEUE_CONCURRENCY_LIMIT=5
MAX_UPLOAD_SIZE_BYTES_IMAGE=10485760
MAX_UPLOAD_SIZE_BYTES_AUDIO=26214400
MAX_UPLOAD_SIZE_BYTES_VIDEO=104857600
# Decompression-bomb guard (width*height ceiling) — added during Phase 3
# implementation, not in the original architecture docs.
MAX_IMAGE_PIXELS=40000000
# Timeout for both the Meta media-metadata request and the actual download —
# added during Phase 3 implementation.
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=15
MAX_PROCESSING_DURATION_SECONDS=120
DUPLICATE_CONTENT_REUSE_ENABLED=true
DUPLICATE_CONTENT_REUSE_WINDOW_HOURS=72

# ==== Audio / Video handling (docs/decisions.md §12/§15, Phase 5) ====
# MAX_AUDIO_DURATION_SECONDS, MAX_VIDEO_DURATION_SECONDS, MAX_VIDEO_FRAMES,
# VIDEO_FRAME_SAMPLING_INTERVAL_SECONDS are new abuse-protection/resource
# ceilings specific to Phase 5's frame-extraction and transcription work —
# never unbounded, see app/media/{audio_validation,video_validation,
# frame_extractor}.py.
MAX_AUDIO_DURATION_SECONDS=600
MAX_VIDEO_DURATION_SECONDS=300
MAX_VIDEO_FRAMES=8
VIDEO_FRAME_SAMPLING_INTERVAL_SECONDS=5.0

# ==== Speech-to-Text (docs/decisions.md §11, Phase A-real)
# [REAL PROVIDER IMPLEMENTED (Sarvam AI), OPT-IN, NOT ACTIVATED BY DEFAULT] —
# selected after comparing against Google Cloud Speech-to-Text (see
# docs/risks-and-open-questions.md for the full writeup): ~2-3x cheaper,
# purpose-built for Indian languages incl. Malayalam/Tamil/Hindi/English,
# code-mixing support. This is genuine, correct client code
# (app/integrations/speech_to_text_client.py) — but no real credentials
# exist in this environment, so it has NEVER been tested against the real
# API, only against a scripted httpx.MockTransport. Setting BOTH variables
# below activates it; leaving either empty keeps NullSpeechToTextProvider
# active (always reports "provider_unavailable", never a fabricated
# transcript). decisions.md §11's benchmark-before-lock-in rule is NOT
# satisfied just by setting these — activating the real provider makes it
# AVAILABLE to benchmark, it doesn't constitute the benchmark itself. See
# app/core/provider_selection.py and app/agent/tools/speech_to_text.py. ====
SPEECH_TO_TEXT_PROVIDER=
SPEECH_TO_TEXT_API_KEY=
SPEECH_TO_TEXT_MODEL=saaras:v3
SPEECH_TO_TEXT_TIMEOUT_SECONDS=30.0

# ==== Audio forensics / AI-voice detection (docs/decisions.md §2, Phase
# B-real) [REAL PROVIDER IMPLEMENTED (Resemble AI Detect), OPT-IN, NOT
# ACTIVATED BY DEFAULT] — never self-hosted, per decisions.md §2. Selected
# as the one self-serve, no-contract option found (Pindrop/Sensity are
# enterprise-sales-only, no self-serve path at all) — see
# docs/risks-and-open-questions.md. COST WARNING: real, non-trivial
# per-unit pricing on Resemble's entry tier (~$0.035/sec audio as of this
# writing) — this was a confirmed, deliberate decision to build the real
# client (app/integrations/media_forensics_client.py) but keep it opt-in
# rather than a default-on spend. Its exact response schema could not be
# confirmed against a live call (no credentials available) — the response
# parser is defensive/best-effort and MUST be validated against a real
# response before being trusted in production. Setting BOTH variables below
# activates it; leaving either empty keeps NullAudioForensicsProvider
# active (always reports "provider_unavailable", never a fabricated
# AI-generation verdict). See app/agent/tools/audio_forensics.py. ====
AUDIO_FORENSICS_PROVIDER=
AUDIO_FORENSICS_API_KEY=
AUDIO_FORENSICS_TIMEOUT_SECONDS=30.0

# ==== Video forensics / AI-generated-video detection (docs/decisions.md §2,
# Phase C-real) [REAL PROVIDER IMPLEMENTED (Resemble AI Detect), OPT-IN,
# NOT ACTIVATED BY DEFAULT] — same provider/client and same caveats as
# audio forensics above (shared implementation,
# app/integrations/media_forensics_client.py). COST WARNING: ~$0.07/sec on
# Resemble's entry tier as of this writing — a 3-minute video would cost
# roughly $12.60 to forensics-check. Setting BOTH variables below activates
# it; leaving either empty keeps NullVideoForensicsProvider active. See
# app/agent/tools/video_forensics.py. ====
VIDEO_FORENSICS_PROVIDER=
VIDEO_FORENSICS_API_KEY=
VIDEO_FORENSICS_TIMEOUT_SECONDS=60.0

# ==== Per-analysis & global LLM/evidence-search budget (docs/decisions.md §1)
# [PHASE 2: IMPLEMENTED; PHASE 3 REUSES THE SAME LIMITS FOR OCR/IMAGE-ANALYSIS
# CALLS — no second budget system] ====
# No monetary values are hard-coded in application code — these are the only
# place limits are set. Placeholder values below; tune once real cost data exists.
MAX_EVIDENCE_SEARCHES_PER_ANALYSIS=5
MAX_LLM_TOOL_CALLS_PER_ANALYSIS=10
DAILY_SPEND_CIRCUIT_BREAKER_USD=50.00
CIRCUIT_BREAKER_QUEUE_ON_TRIP=true
# Rough per-call cost estimates used ONLY to trip the daily circuit breaker —
# not real billing reconciliation. Added during Phase 2 implementation.
ESTIMATED_COST_PER_SEARCH_USD=0.01
ESTIMATED_COST_PER_LLM_CALL_USD=0.02

# ==== Evidence-tier policy (docs/decisions.md §3/§5) [PHASE 2: IMPLEMENTED]
# Added during Phase 2 implementation — not in the original architecture docs. ====
MIN_CONCURRING_TIER2_SOURCES=2
HIGH_IMPACT_CATEGORIES=elections,gov_scheme

# ==== Retention defaults (docs/decisions.md §8) [PHASE 6: IMPLEMENTED — see
# app/agent/retention.py]. Purge deletes METADATA ROWS ONLY
# (media_attachments/analyses + their cascaded children) — Phase 3 never
# persisted raw media blobs in the first place, so there is no blob store to
# purge separately. Run by a lightweight in-process asyncio periodic task
# (main.py lifespan), not Celery — matches this project's established
# BackgroundTasks-over-Celery precedent. ====
PRIVACY_MODE_DEFAULT=true
PRIVACY_MODE_MEDIA_TTL_MINUTES=15
PRIVACY_MODE_ANALYSIS_TTL_HOURS=48
STANDARD_RETENTION_MONTHS=24
RETENTION_PURGE_INTERVAL_SECONDS=300

# ==== WhatsApp-OTP dashboard login (Phase 6, api-design.md) [PHASE 6:
# IMPLEMENTED — reuses the existing WhatsAppSender; see app/api/v1/auth.py's
# module docstring for the documented production limitation: this is a
# genuinely PROACTIVE message send outside any inbound conversation window,
# which needs a pre-approved Meta message template in a real deployment —
# same precondition decisions.md §4/§14 already established for "Check This
# Tomorrow". Built and fully tested here per explicit instruction.] ====
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60

# ==== Dashboard API rate limiting (docs/decisions.md §12/§15) [PHASE 7:
# IMPLEMENTED] — reuses app/core/rate_limit.py's RateLimiter (the same
# mechanism Phase 1 built for the webhook), keyed by user_id for
# authenticated /api/v1/* routes and by client IP for the pre-auth
# POST /auth/link/start (bounds real per-message WhatsApp-send cost
# exposure, not just abuse). See app/api/v1/deps.py / routers/auth.py. ====
DASHBOARD_RATE_LIMIT_PER_USER_PER_MINUTE=60
OTP_START_RATE_LIMIT_PER_IP_PER_MINUTE=10

# ==== Safety gate — prohibited content (docs/decisions.md §6) [PHASE 3:
# NON-BYPASSABLE GATE STAGE IMPLEMENTED, NO REAL PROVIDER WIRED] — vendor/
# procedure intentionally NOT decided, pending mandatory legal/professional
# review (decisions.md §6 — confirmed, not reinterpreted). SAFETY_GATE_PROVIDER
# stays empty; NullSafetyProvider is used, which always passes content
# through and loudly logs a warning on every use. SAFETY_GATE_ENABLED exists
# for a future kill-switch but is not yet read by application code (the gate
# always runs). THE SYSTEM MUST NOT BE EXPOSED PUBLICLY until a real,
# legally-approved provider is configured here. ====
SAFETY_GATE_ENABLED=true
SAFETY_GATE_PROVIDER=
SAFETY_GATE_API_KEY=

# ==== Security (docs/decisions.md §15) ====
# SSRF_BLOCKLIST_ENABLED: [PHASE 3+4: WIRED] to both the media downloader
# (app/media/downloader.py) and the URL fetcher (app/web/fetcher.py) — every
# WhatsApp media URL AND every user-submitted URL (including every redirect
# hop it follows) is resolved and checked against private/internal IP
# ranges before any fetch. Note: the config toggle itself is not yet read by
# application code — the check always runs; the variable exists as a
# documented future kill-switch.
# PROMPT_INJECTION_GUARD_ENABLED: [PHASE 2: IMPLEMENTED] — evidence/claim
# text is always passed to Claude as delimited untrusted data, never as
# instructions; enforced in app/agent/tools/.
SSRF_BLOCKLIST_ENABLED=true
PROMPT_INJECTION_GUARD_ENABLED=true

# ==== Hosting portability (docs/decisions.md §10) [NOT YET USED — informational only] ====
# No cloud provider is hard-coded; this only records the current target for
# local/dev convenience. Production region depends on the DPDP review outcome.
DEPLOY_REGION_HINT=local

# ==== Phase 8 — "Check This Tomorrow" scheduled re-checks (decisions.md §14) ====
# Backend scheduling/re-check infrastructure only. The proactive WhatsApp SEND
# stays blocked regardless of these values (app/agent/notifications.py always
# writes channel='whatsapp' rows as delivery_status='blocked_by_policy') until
# decisions.md §4's three preconditions are met: Meta requirements confirmed,
# message template approved, messaging costs budgeted.
SCHEDULED_CHECK_DEFAULT_DELAY_HOURS=24
SCHEDULED_CHECK_EXECUTION_INTERVAL_SECONDS=300

# ==== Phase 8 — Explore rollup (app/agent/explore_rollup.py) ====
# In-process asyncio periodic task, same pattern as the retention purge — NOT
# a separate scheduler/worker. Only privacy-mode-excluded, completed analyses
# are aggregated (docs/api-design.md's structural privacy enforcement).
EXPLORE_ROLLUP_INTERVAL_SECONDS=600
EXPLORE_ROLLUP_LOOKBACK_HOURS=720
# Explore is deliberately public/unauthenticated, so its rate limit is per-IP.
EXPLORE_RATE_LIMIT_PER_IP_PER_MINUTE=60

# ==== Phase 7 — dashboard request-size ceiling (app/core/http_hardening.py) ====
# Content-Length-based 413 for /api/v1/* bodies. Honest limitation: a chunked
# request with no Content-Length header bypasses this specific check.
DASHBOARD_MAX_REQUEST_BODY_BYTES=65536

# ==== Phase 9 — Admin system (roadmap §9.1) ====
# Admin sessions reuse the SAME JWT_SECRET as dashboard tokens — the token_type
# claim, not a second secret, is what prevents an admin token being replayed as
# a dashboard token or vice versa (app/core/jwt_auth.py). The TTL is shorter
# than the dashboard default because admin sessions are higher-privilege.
# There is NO admin signup endpoint: create the first admin locally with
#   python -m scripts.create_admin --email you@example.com --role admin
ADMIN_JWT_ACCESS_TOKEN_TTL_SECONDS=1800
ADMIN_LOGIN_RATE_LIMIT_PER_IP_PER_MINUTE=5
ADMIN_RATE_LIMIT_PER_ADMIN_PER_MINUTE=120

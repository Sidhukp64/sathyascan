# SathyaScan backend — now through Phase 9 (Production Completion & Trust).
# Build context is expected to be the repo root, e.g.:
#   docker build -f infra/docker/Dockerfile.api -t sathyascan-api .

FROM python:3.12-slim

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/app ./app
# Phase 9 fix: alembic.ini + migrations/ were never copied into the image,
# even after Phase 2 added a real migration set — `alembic upgrade head`
# could never actually run FROM inside this container, only on a host
# checkout. Needed for `docker compose run --rm api alembic upgrade head`
# (see infra/docker-compose.yml's `api` service comment) to work at all.
COPY backend/alembic.ini .
COPY backend/migrations ./migrations
COPY dashboard ./dashboard

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
